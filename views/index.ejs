<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mini Message Board</title>
</head>
<body> 
    <a href="/new"><button>New Message</button></a>

    <% messages.forEach((message, index) => { %>
        <li>
            <strong><%= message.user %></strong>: <%= message.text %>
            <em>(<%= message.added.toDateString() %>)</em>
            <!-- Uses the get method in indexRouter where index is based on the messages array initizlized locally in indexRouter-->
            <a href="/messages/<%= index %>">View</a>
        </li>
    <% }) %>
     
</body>
</html>